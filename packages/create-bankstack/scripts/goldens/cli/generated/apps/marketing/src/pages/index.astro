---
import {
  BANKSTACK_STACK_LABEL,
  describeLocalStack,
} from "@golden-stack/shared-utils";
import { primaryActionClassName } from "@golden-stack/ui";

const projectName = "golden-stack";
const stackSummary = describeLocalStack(projectName);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`Marketing home page for ${projectName}, generated by create-bankstack.`}
    />
    <title>{projectName} | Bankstack</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">{BANKSTACK_STACK_LABEL}</p>
      <h1>{projectName} ships on a split stack.</h1>
      <p class="lede">
        {stackSummary}
      </p>
      <a
        class={`${primaryActionClassName} primary-link`}
        href="http://localhost:5173">Open dashboard</a
      >
    </main>
    <footer>
      Built with
      <a
        href="https://bankstack.dev/"
        target="_blank"
        rel="nofollow noopener noreferrer">Bankstack</a>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: oklch(23% 0.035 235);
    background: oklch(97% 0.012 215);
  }

  main {
    width: min(100% - 2rem, 66rem);
    min-height: 100vh;
    display: grid;
    align-content: center;
    margin: 0 auto;
    padding: 4rem 0 5rem;
  }

  .eyebrow {
    margin: 0 0 0.8rem;
    color: oklch(47% 0.085 185);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.92;
    letter-spacing: 0;
  }

  .lede {
    max-width: 45rem;
    margin: 1.4rem 0 2rem;
    color: oklch(38% 0.04 235);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.65;
  }

  .primary-link {
    width: fit-content;
    border: 1px solid oklch(29% 0.04 235);
    border-radius: 0.45rem;
    padding: 0.82rem 1rem;
    color: oklch(96% 0.01 220);
    background: oklch(27% 0.045 235);
    font-weight: 700;
    text-decoration: none;
  }

  footer {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    color: oklch(43% 0.035 235);
    font-size: 0.88rem;
  }

  footer a {
    color: oklch(29% 0.05 235);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
