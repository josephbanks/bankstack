{
  "name": "golden-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Bankstack workspace generated by create-bankstack.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "dev": "nx run-many -t dev --parallel=3",
    "build": "nx run-many -t build",
    "check": "nx run-many -t check",
    "test": "nx run-many -t test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "nx": "22.7.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3"
  }
}
