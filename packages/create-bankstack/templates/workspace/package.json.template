{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Bankstack workspace generated by create-bankstack.",
  "license": "MIT",
  "packageManager": "{{PACKAGE_MANAGER}}",
  "engines": {
    "node": "{{NODE_ENGINE}}",
    "pnpm": "{{PNPM_ENGINE}}"
  },
  "scripts": {
    "dev": "nx run-many -t dev --parallel=3",
    "build": "nx run-many -t build",
    "check": "nx run-many -t check",
    "test": "nx run-many -t test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "{{DEV_DEPENDENCY_TYPES_NODE}}",
    "nx": "{{DEV_DEPENDENCY_NX}}",
    "prettier": "{{DEV_DEPENDENCY_PRETTIER}}",
    "typescript": "{{DEV_DEPENDENCY_TYPESCRIPT}}"
  }
}
