# Local API defaults. These are optional for scaffold verification.
PORT=8787
HOST=127.0.0.1

# Demo-only bearer token for /protected/* while Supabase JWT verification is still a stub.
BANKSTACK_API_DEMO_TOKEN=replace-with-a-local-demo-token

# Supabase values are required only after you connect a real project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret
