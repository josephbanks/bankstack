{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "{{PROJECT_NAME}}-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-14",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "BANKSTACK_ENV": "local",
  },
  "env": {
    "staging": {
      "name": "{{PROJECT_NAME}}-api-staging",
      "vars": {
        "BANKSTACK_ENV": "staging",
      },
    },
    "production": {
      "name": "{{PROJECT_NAME}}-api",
      "vars": {
        "BANKSTACK_ENV": "production",
      },
    },
  },
}
