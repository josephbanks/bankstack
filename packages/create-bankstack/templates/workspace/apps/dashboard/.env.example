# Optional local proxy to the Hono API when you are not using a Cloudflare service binding.
BANKSTACK_API_URL=http://127.0.0.1:8787

# Public Supabase browser client values. Leave unset until you connect a real project.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
