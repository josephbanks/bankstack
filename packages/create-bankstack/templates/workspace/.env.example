# Shared local examples. Copy app-specific values into each app when needed.

# Hono API local URL used by the dashboard fallback proxy.
BANKSTACK_API_URL=http://127.0.0.1:8787

# Supabase is optional for local scaffold verification and required for real auth/data.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret
