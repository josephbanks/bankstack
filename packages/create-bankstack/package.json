{
  "name": "create-bankstack",
  "version": "0.1.0-alpha.0",
  "description": "Create a Bankstack split-stack workspace.",
  "license": "MIT",
  "author": "Joseph Banks",
  "keywords": [
    "bankstack",
    "cloudflare",
    "supabase",
    "nx",
    "scaffold",
    "create"
  ],
  "type": "module",
  "bin": {
    "create-bankstack": "./dist/index.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "scripts": {
