---
import { getCollection, type CollectionEntry } from "astro:content";
import SiteLayout from "./SiteLayout.astro";
import { sortDocs } from "../lib/docs";

interface Props {
  entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const docs = sortDocs(await getCollection("docs"));
---

<SiteLayout title={entry.data.title} description={entry.data.description}>
  <div class="docs-shell">
    <aside class="docs-sidebar" aria-label="Docs navigation">
      <a class="docs-sidebar__home" href="/docs/">Docs overview</a>
      <nav class="docs-sidebar__nav">
        {
          docs.map((doc) => (
            <a
              href={`/docs/${doc.id}/`}
              aria-current={doc.id === entry.id ? "page" : undefined}
            >
              {doc.data.title}
            </a>
          ))
        }
      </nav>
    </aside>
    <article class="docs-article">
      <p class="eyebrow">Docs</p>
      <h1>{entry.data.title}</h1>
      <p class="docs-description">{entry.data.description}</p>
      <div class="docs-content">
        <slot />
      </div>
    </article>
  </div>
</SiteLayout>
