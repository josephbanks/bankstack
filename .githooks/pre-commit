#!/bin/sh
set -eu

echo "pre-commit: formatting workspace with Prettier"
pnpm format

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -n "$staged_files" ]; then
  echo "pre-commit: staging formatted versions of files in this commit"
  printf "%s\n" "$staged_files" | while IFS= read -r file; do
    if [ -e "$file" ]; then
      git add -- "$file"
    fi
  done
fi

echo "pre-commit: checking that this commit is buildable and functional"
pnpm verify:functional
