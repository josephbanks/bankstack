{
  "name": "bankstack",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Scaffolding and conventions for Cloudflare edge plus Supabase split-stack Nx monorepos.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "hooks:install": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "nx run-many -t check",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "smoke:generated": "pnpm --filter create-bankstack smoke:generated",
    "verify:functional": "pnpm check && pnpm build && pnpm test",
    "verify:commit": "pnpm format && pnpm verify:functional",
    "verify:push": "pnpm format:check && pnpm verify:functional"
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "nx": "22.7.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3"
  }
}
